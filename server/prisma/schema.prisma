generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Post {
  id        BigInt   @id(map: "posts_pk") @default(autoincrement())
  title     String   @db.VarChar(150)
  content   String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  @@map("posts")
}
